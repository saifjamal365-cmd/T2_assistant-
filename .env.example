# Copy this file to ".env" and fill in the real values.
# ".env" is git-ignored and must never be committed.

# --- Groq (the LLM) -------------------------------------------------------
# Get a key from https://console.groq.com  ->  API Keys
GROQ_API_KEY=your-groq-key-here

# Optional overrides (defaults are set in src/t2_assistant/config.py):
# LLM_MODEL=openai/gpt-oss-120b
# LLM_TEMPERATURE=0.2

# --- MLflow (tracing) ---------------------------------------------------
# Default writes traces to a local ./mlruns folder. Usually leave this alone.
# MLFLOW_TRACKING_URI=file:./mlruns
# MLFLOW_EXPERIMENT=t2-assistant

# --- Sign-in (email + one-time code) ------------------------------------
# Get a key from https://resend.com -> API Keys. Needed to send the code by
# email; without it the app still runs but sign-in will fail.
RESEND_API_KEY=your-resend-key-here

# Only emails ending in this domain may sign in. Defaults to t2.sa.
# AUTH_EMAIL_DOMAIN=t2.sa

# Real inboxes to allow for testing, even though they don't match the domain
# above - a JSON list. Remove once a real company inbox can receive mail.
# AUTH_ALLOWED_TEST_EMAILS=["you@example.com"]
