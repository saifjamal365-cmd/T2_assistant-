# Copy this file to ".env" and fill in the real values.
# ".env" is git-ignored and must never be committed.

# --- Groq (the LLM) -------------------------------------------------------
# Get a key from https://console.groq.com  ->  API Keys
GROQ_API_KEY=your-groq-key-here

# Optional overrides (defaults are set in src/t2_assistant/config.py):
# LLM_MODEL=openai/gpt-oss-120b
# LLM_TEMPERATURE=0.2

# --- MLflow (tracing) ---------------------------------------------------
# Default writes traces to a local ./mlruns folder. Usually leave this alone.
# MLFLOW_TRACKING_URI=file:./mlruns
# MLFLOW_EXPERIMENT=t2-assistant
